{
  "name": "@lvxianchao/dsh-video-preview",
  "version": "1.1.1",
  "description": "Streaming video preview for the DeepSeek Harness Web UI: click an mp4/webm/mov in the file sidebar and it plays in place over an authenticated byte-range route — seeking and large files included, no build step, zero runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "lvxianchao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvxianchao/dsh-video-preview.git"
  },
  "homepage": "https://github.com/lvxianchao/dsh-video-preview#readme",
  "bugs": {
    "url": "https://github.com/lvxianchao/dsh-video-preview/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "preview",
    "mp4",
    "webm",
    "cordis"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://afdian.com/a/lvxianchao"
    },
    {
      "type": "individual",
      "url": "https://ko-fi.com/lvxianchao"
    }
  ]
}
